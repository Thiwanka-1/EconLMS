# Copy to /etc/econlms/mongodb-backup.env, edit it, then set owner root:root
# and mode 0600. Do not put credentials in this file or commit the real file.

MONGODB_DATABASE=EconLMS
MONGODB_CONFIG_FILE=/etc/econlms/mongodump.yml
BACKUP_PASSPHRASE_FILE=/etc/econlms/mongodb-backup.passphrase
BACKUP_TIMEZONE=Asia/Colombo

# Private Oracle Object Storage bucket and the VM's Oracle region.
OCI_BUCKET_NAME=econlms-backups
OCI_REGION=ap-mumbai-1
# Find this on the bucket details page. It is the tenancy Object Storage
# namespace, not the tenancy name or OCID.
OCI_NAMESPACE=YOUR_OBJECT_STORAGE_NAMESPACE
OCI_OBJECT_PREFIX=mongodb
OCI_CLI_BIN=/usr/local/bin/oci

# Local encrypted copies are only a short cache. Object Storage lifecycle
# policies provide the real daily, weekly and monthly retention.
LOCAL_RETENTION_DAYS=3
# Reject tiny archives caused by a wrong database name or missing privileges.
MIN_BACKUP_BYTES=1024
OPENSSL_PBKDF2_ITERATIONS=200000
