# Core runtime
NODE_ENV=development
PORT=5000
APP_TIMEZONE=Asia/Colombo
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/econlls

# Authentication - use independent secrets of at least 32 characters
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
OTP_HASH_SECRET=replace-with-another-long-random-secret
OTP_EXPIRES_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60

# Browser client / cookie policy
# Local:
CLIENT_URL=http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173
TRUST_PROXY=0
COOKIE_NAME=econlls_auth
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_MAX_AGE_DAYS=7

# Render production uses values like:
# CLIENT_URL=https://econlls-client.onrender.com
# CLIENT_ORIGINS=https://econlls-client.onrender.com
# TRUST_PROXY=1
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=none
# Leave COOKIE_DOMAIN unset for Render.

# SMTP - used for OTP and student notification emails
# Gmail: create an App Password after enabling 2-Step Verification.
EMAIL_PROVIDER=smtp
EMAIL_NOTIFICATIONS_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-account@gmail.com
SMTP_PASS=replace-with-google-app-password
SMTP_MAX_CONNECTIONS=3
SMTP_MAX_MESSAGES=100
EMAIL_FROM=EconLLS <your-account@gmail.com>

# Google Drive - required for payment slips and NIC documents
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REFRESH_TOKEN=replace-me
GDRIVE_PAYMENT_SLIPS_FOLDER_ID=replace-me
GDRIVE_NIC_DOCUMENTS_FOLDER_ID=replace-me

# Zoom - required for live-class registration and unique join links
ZOOM_ACCOUNT_ID=replace-me
ZOOM_CLIENT_ID=replace-me
ZOOM_CLIENT_SECRET=replace-me
# Optional exact ID of the Zoom matching-invited-email authentication profile.
# If empty, EconLMS verifies Zoom's returned authentication profile name.
ZOOM_REQUIRED_AUTHENTICATION_OPTION=
# Exactly 64 hexadecimal characters. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ZOOM_LINK_ENCRYPTION_KEY=replace-with-64-hex-characters
ZOOM_DEFAULT_JOIN_BEFORE_MINUTES=30
ZOOM_DEFAULT_JOIN_AFTER_MINUTES=15

# Learning and uploads
DEFAULT_LESSON_MAX_VIEWS=2
PLAYBACK_HEARTBEAT_SECONDS=20
PLAYBACK_STALE_MINUTES=3
PAYMENT_SLIP_MAX_MB=5
NIC_IMAGE_MAX_MB=5
REQUEST_BODY_LIMIT=1mb

# Rate limits
GLOBAL_RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10
OTP_SEND_RATE_LIMIT_MAX=5
UPLOAD_RATE_LIMIT_MAX=20

# Never enable these in production
BILLING_CRON_TEST_MODE=false
# Comma-separated days before a monthly payment deadline.
PAYMENT_REMINDER_DAYS_BEFORE=6,3
PAYMENT_REMINDER_HOUR=9
# TEST_BILLING_DATE=

# One-time local admin seeding only; do not add these to Render after seeding
# ADMIN_FIRST_NAME=Admin
# ADMIN_LAST_NAME=User
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-a-strong-password
